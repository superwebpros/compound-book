    {
      "id": "q-0",
      "type": "text",
      "x": 80,
      "y": 156,
      "width": 340,
      "height": 40,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "1. Did the sprint reveal new\n   information about other constraints?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "1. Did the sprint reveal new\n   information about other constraints?"
    },
    {
      "id": "q-1",
      "type": "text",
      "x": 80,
      "y": 206,
      "width": 340,
      "height": 40,
      "angle": 0,
